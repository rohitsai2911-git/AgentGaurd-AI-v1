AGENTGUARD_NAME=AgentGuard AI
AGENTGUARD_VERSION=0.2.0
AGENTGUARD_DEBUG=false
AGENTGUARD_LOG_LEVEL=INFO
AGENTGUARD_DATABASE_URL=sqlite:///./agentguard.db
AGENTGUARD_AUTO_SEED=false

# --- Optional LLM judge via OpenRouter (OpenAI-compatible) ---
# Leave blank to run fully offline on deterministic evaluation.
# Never commit a real key. Set in environment / .env only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional overrides:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=20
# OPENROUTER_MAX_TOKENS=1200

# --- Optional Laya local decision engine ---
# Disabled by default. Set true to enable local structured decisions.
# No keys needed. First inference downloads the routed checkpoint once
# (~400MB via Hugging Face), then runs offline on CPU (~35ms/decision).
# Never required: disabled/missing model degrades to deterministic results.
LAYA_ENABLED=false
# Optional overrides:
# LAYA_MODEL=            # blank = auto router (english/multilingual/typed-decisions)
# LAYA_TIMEOUT_SECONDS=60
# LAYA_MIN_CONFIDENCE=0.0